{
  "name": "businessday.gs",
  "version": "1.0.0",
  "description": "Business day calculation module for Google Apps Script",
  "scripts": {
    "lint": "eslint --fix",
    "format": "prettier --write",
    "build": "vite build",
    "clasp:login": "clasp login",
    "clasp:create": "clasp create --rootDir dist",
    "clasp:clone": "clasp clone --rootDir dist",
    "clasp:open": "clasp --project .clasp.json open-script",
    "clasp:push": "clasp --project .clasp.json push",
    "clasp:pull": "clasp --project .clasp.json pull",
    "clasp:version": "clasp --project .clasp.json create-version $(git rev-parse --short=7 HEAD)",
    "clasp:version:list": "clasp --project .clasp.json list-versions",
    "clasp:deploy": "clasp --project .clasp.json create-deployment",
    "clasp:deploy:list": "clasp --project .clasp.json list-deployments"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyoppomu/businessday.gs.git"
  },
  "keywords": [
    "GAS"
  ],
  "author": "jyoppomu <jyoppomu@gmail.com> (https://jyoppomu.github.io/tips/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jyoppomu/businessday.gs/issues"
  },
  "homepage": "https://github.com/jyoppomu/businessday.gs#readme",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@google/clasp": "3.4.1",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/google-apps-script": "1.0.100",
    "@types/node": "22.20.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "gas-entry-generator": "3.0.0",
    "globals": "16.5.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.6",
    "rollup": "4.63.3",
    "rollup-pluginutils": "2.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.26.0"
}